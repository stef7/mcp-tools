{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-fetch",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "keep_vars": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fetch",
      "database_id": "ebab875e-7022-4e7a-881e-f57e15e2926d"
    }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "acdda8800378466aa9ecf9caabd317dc" }],
  "ai": { "binding": "AI" },
  "vpc_services": [
    { "binding": "TUNNEL", "service_id": "01a0e1f9-8cbe-70a2-9db4-78073bfbe540", "remote": true }
  ]
}
